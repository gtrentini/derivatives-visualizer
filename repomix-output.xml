  padding: 1.15rem 1.6rem;
  border-bottom: 1px solid $border-subtle;
  background-color: $bg-card;

  .titleGroup {
    display: flex;
    align-items: center;
    gap: 0.75rem;

    .iconWrapper {
      color: $color-cyan;
      display: flex;
      align-items: center;
    }

