  TSLA: { spot: 220.0, divYield: 0.0, histVol: 0.52 },
  MSFT: { spot: 420.0, divYield: 0.0075, histVol: 0.21 },
  AMZN: { spot: 190.0, divYield: 0.0, histVol: 0.26 },
  IWM: { spot: 225.0, divYield: 0.012, histVol: 0.21 },
};

let cachedCrumb: string | null = null;

/**
 * Attempts to retrieve a Yahoo Finance crumb if needed
 */
const getYahooCrumb = async (): Promise<string | null> => {
  if (cachedCrumb) return cachedCrumb;
  try {
    const res = await fetch('/api/yahoo/v1/test/getcrumb');
    if (res.ok) {
      const crumb = await res.text();
      if (crumb && !crumb.includes('{') && !crumb.includes('error')) {
        cachedCrumb = crumb.trim();
        return cachedCrumb;
      }
    }
  } catch {
    // Crumb fetch failed, will proceed without crumb
  }
  return null;
};

/**
 * Generates a realistic simulated option chain when network is unavailable
 * or ticker is not found on live exchanges.
 */
export const generateSimulatedOptionChain = (
  symbol: string,
  expirationTimestamp?: number
): LiveOptionChainData => {
  const upper = symbol.toUpperCase();
  const info = TICKER_DEFAULTS[upper] || { spot: 500.0, divYield: 0.013, histVol: 0.22 };
  const spot = info.spot;
  const divYield = info.divYield;

  // Generate 6 realistic expiration dates (7d, 14d, 30d, 45d, 60d, 90d)
  const now = Math.floor(Date.now() / 1000);
  const expirationOffsets = [7, 14, 30, 45, 60, 90];
  const expirationDates = expirationOffsets.map((days) => now + days * 86400);

  const selectedExpiration =
    expirationTimestamp && expirationDates.includes(expirationTimestamp)
      ? expirationTimestamp
      : expirationDates[2]; // Default ~30 DTE

  const dte = Math.max(1, Math.round((selectedExpiration - now) / 86400));
  const timeYears = dte / 365;

  // Choose strike interval based on spot price magnitude
  const step = spot < 100 ? 2.5 : 5;

  const centerStrike = Math.round(spot / step) * step;
  const strikes: number[] = [];
  const numWings = 10;

  for (let i = -numWings; i <= numWings; i++) {
    const strike = Number((centerStrike + i * step).toFixed(2));
    if (strike > 0) {
      strikes.push(strike);
    }
  }

  const calls: OptionContractQuote[] = [];
  const puts: OptionContractQuote[] = [];

  for (const strike of strikes) {
    // Volatility smile: OTM puts get higher skew
    const moneyness = Math.log(strike / spot);
    const skew = Math.max(-0.05, Math.min(0.15, -0.3 * moneyness));
    const iv = Math.max(0.12, Math.min(0.9, info.histVol + skew));

    // Calculate Black-Scholes call & put prices
    const callGreeks = calculateBlackScholes(
      spot,
      strike,
      timeYears,
      iv,
      0.045,
      divYield,
      'CALL'
    );

    const putGreeks = calculateBlackScholes(
      spot,
      strike,
      timeYears,
      iv,
      0.045,
      divYield,
      'PUT'
    );

    const callMid = Math.max(0.05, callGreeks.price);
    const putMid = Math.max(0.05, putGreeks.price);

    const callSpread = Math.max(0.05, Number((callMid * 0.04).toFixed(2)));
    const putSpread = Math.max(0.05, Number((putMid * 0.04).toFixed(2)));

    const callBid = Math.max(0.01, Number((callMid - callSpread / 2).toFixed(2)));
    const callAsk = Number((callMid + callSpread / 2).toFixed(2));

    const putBid = Math.max(0.01, Number((putMid - putSpread / 2).toFixed(2)));
    const putAsk = Number((putMid + putSpread / 2).toFixed(2));

    const expDateStr = new Date(selectedExpiration * 1000)
      .toISOString()
      .slice(2, 10)
      .replace(/-/g, '');

    const strikeStr = String(Math.round(strike * 1000)).padStart(8, '0');

    calls.push({
      contractSymbol: `${upper}${expDateStr}C${strikeStr}`,
      strike,
      lastPrice: Number(callMid.toFixed(2)),
      bid: callBid,
      ask: callAsk,
      change: Number(((Math.random() - 0.48) * 1.5).toFixed(2)),
      percentChange: Number(((Math.random() - 0.48) * 4).toFixed(2)),
      volume: Math.floor(Math.random() * 2500) + 120,
      openInterest: Math.floor(Math.random() * 8000) + 450,
      impliedVolatility: Number(iv.toFixed(4)),
      inTheMoney: spot > strike,
      expiration: selectedExpiration,
    });

    puts.push({
      contractSymbol: `${upper}${expDateStr}P${strikeStr}`,
      strike,
      lastPrice: Number(putMid.toFixed(2)),
      bid: putBid,
      ask: putAsk,
      change: Number(((Math.random() - 0.48) * 1.5).toFixed(2)),
      percentChange: Number(((Math.random() - 0.48) * 4).toFixed(2)),
      volume: Math.floor(Math.random() * 2500) + 120,
      openInterest: Math.floor(Math.random() * 8000) + 450,
      impliedVolatility: Number(iv.toFixed(4)),
      inTheMoney: spot < strike,
      expiration: selectedExpiration,
    });
  }

  return {
    symbol: upper,
    underlyingPrice: spot,
    dividendYield: divYield,
    expirationDates,
    selectedExpiration,
    calls,
    puts,
    isLive: false,
    dataSource: 'SIMULATED_MODEL',
  };
};

/**
 * Fetches real live options chain from Yahoo Finance via Vite proxy.
 * If network fails or ticker is not found, seamlessly falls back to
 * high-fidelity quantitative model simulation.
 */
export const fetchLiveOptionChain = async (
  symbol: string,
  expirationTimestamp?: number
): Promise<LiveOptionChainData> => {
  const cleanSymbol = symbol.trim().toUpperCase();

  try {
    const crumb = await getYahooCrumb();
    const queryParams = new URLSearchParams();
    if (expirationTimestamp) {
      queryParams.set('date', String(expirationTimestamp));
    }
    if (crumb) {
      queryParams.set('crumb', crumb);
    }

    const queryString = queryParams.toString() ? `?${queryParams.toString()}` : '';
    const url = `/api/yahoo/v7/finance/options/${encodeURIComponent(cleanSymbol)}${queryString}`;

    const response = await fetch(url, {
      headers: {
        Accept: 'application/json',
      },
    });

    if (!response.ok) {
      console.warn(`[MarketData] Yahoo API returned HTTP ${response.status}. Using model fallback.`);
      return generateSimulatedOptionChain(cleanSymbol, expirationTimestamp);
    }

    const data = await response.json();
    const result = data?.optionChain?.result?.[0];

    if (!result) {
      console.warn('[MarketData] No optionChain result. Using model fallback.');
      return generateSimulatedOptionChain(cleanSymbol, expirationTimestamp);
    }

    // Parse Underlying Spot Price
    const quote = result.quote || {};
    const rawSpot = quote.regularMarketPrice || quote.bid || quote.ask;
    const spot = Number(rawSpot) > 0 ? Number(rawSpot) : (TICKER_DEFAULTS[cleanSymbol]?.spot ?? 500);

    // Parse Dividend Yield (handle percentage vs decimal)
    let dividendYield = 0.013;
    if (typeof quote.trailingAnnualDividendYield === 'number') {
      dividendYield = quote.trailingAnnualDividendYield;
    } else if (typeof quote.dividendYield === 'number') {
      dividendYield = quote.dividendYield > 0.5 ? quote.dividendYield / 100 : quote.dividendYield;
    } else if (TICKER_DEFAULTS[cleanSymbol]) {
      dividendYield = TICKER_DEFAULTS[cleanSymbol].divYield;
    }

    const expirationDates: number[] = Array.isArray(result.expirationDates)
      ? result.expirationDates
      : [];

    const optionsBlock = result.options?.[0] || {};
    const selectedExpiration =
      optionsBlock.expirationDate ||
      expirationTimestamp ||
      (expirationDates.length > 0 ? expirationDates[0] : Math.floor(Date.now() / 1000) + 30 * 86400);

    const mapContract = (raw: Record<string, unknown>): OptionContractQuote => {
      const strike = Number(raw.strike) || 0;
      const lastPrice = Math.max(0.01, Number(raw.lastPrice) || 0);
      const bid = Math.max(0, Number(raw.bid) || lastPrice);
      const ask = Math.max(0, Number(raw.ask) || lastPrice);
      const rawIv = Number(raw.impliedVolatility);
      const impliedVolatility = rawIv > 0.001 ? rawIv : 0.2;

      return {
        contractSymbol: String(raw.contractSymbol || `${cleanSymbol}-${strike}`),
        strike,
        lastPrice,
        bid,
        ask,
        change: Number(raw.change) || 0,
        percentChange: Number(raw.percentChange) || 0,
        volume: Number(raw.volume) || 0,
        openInterest: Number(raw.openInterest) || 0,
        impliedVolatility,
        inTheMoney: Boolean(raw.inTheMoney),
        expiration: Number(raw.expiration) || selectedExpiration,
      };
    };

    const rawCalls = Array.isArray(optionsBlock.calls) ? optionsBlock.calls : [];
    const rawPuts = Array.isArray(optionsBlock.puts) ? optionsBlock.puts : [];

    const calls = rawCalls.map((c: Record<string, unknown>) => mapContract(c));
    const puts = rawPuts.map((p: Record<string, unknown>) => mapContract(p));

    // If both calls and puts are empty for this date, fallback to simulated chain
    if (calls.length === 0 && puts.length === 0) {
      return generateSimulatedOptionChain(cleanSymbol, selectedExpiration);
    }

    return {
      symbol: cleanSymbol,
      underlyingPrice: Number(spot.toFixed(2)),
      dividendYield: Number(dividendYield.toFixed(4)),
      expirationDates,
      selectedExpiration,
      calls,
      puts,
      isLive: true,
      dataSource: 'LIVE_EXCHANGE',
    };
  } catch (err) {
    console.warn('[MarketData] Network error while fetching live options. Using model fallback.', err);
    return generateSimulatedOptionChain(cleanSymbol, expirationTimestamp);
  }
};
