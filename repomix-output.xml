<file path="src/services/math/blackScholes.ts">
import { cdf, pdf } from './normalDistribution.ts';
import type { OptionLeg, OptionType } from '../../types/derivatives.ts';

export interface GreeksResult {
  price: number;
  delta: number;
  gamma: number;
  theta: number;
  vega: number;
  rho: number;
}

/**
 * Calculates European option price and analytical Greeks under the Black-Scholes-Merton model
 * with continuous dividend yield q.
 *
 * @param spot Current underlying price S
 * @param strike Strike price K
 * @param timeToExpiryYears Time to expiration in years T (e.g. DTE / 365)
 * @param volatility Annualized volatility sigma (e.g. 0.20 for 20%)
 * @param riskFreeRate Annualized continuously compounded risk-free rate r
 * @param dividendYield Annualized continuous dividend yield q
 * @param type 'CALL' | 'PUT'
 */
export const calculateBlackScholes = (
  spot: number,
  strike: number,
  timeToExpiryYears: number,
  volatility: number,
  riskFreeRate: number,
  dividendYield: number,
  type: OptionType
): GreeksResult => {
  const isCall = type === 'CALL';

  // Boundary condition: Expired or zero volatility -> Intrinsic value & zero time-decay Greeks
  if (timeToExpiryYears <= 0.0001 || volatility <= 0.0001) {
    const intrinsic = isCall ? Math.max(0, spot - strike) : Math.max(0, strike - spot);
    const delta = isCall
      ? spot > strike
        ? 1
        : spot === strike
        ? 0.5
        : 0
      : spot < strike
      ? -1
      : spot === strike
      ? -0.5
      : 0;

    return {
      price: intrinsic,
      delta,
      gamma: 0,
      theta: 0,
      vega: 0,
      rho: 0,
    };
  }

  const S = Math.max(0.0001, spot);
  const K = Math.max(0.0001, strike);
  const T = Math.max(0.0001, timeToExpiryYears);
  const sigma = Math.max(0.0001, volatility);
  const r = riskFreeRate;
  const q = dividendYield;

  const sqrtT = Math.sqrt(T);
  const sigmaSqrtT = sigma * sqrtT;

  const d1 = (Math.log(S / K) + (r - q + 0.5 * sigma * sigma) * T) / sigmaSqrtT;
  const d2 = d1 - sigmaSqrtT;

  const expNegativeQT = Math.exp(-q * T);
  const expNegativeRT = Math.exp(-r * T);

  const Nd1 = cdf(d1);
  const Nd2 = cdf(d2);
  const NNegD1 = cdf(-d1);
  const NNegD2 = cdf(-d2);
  const pdfD1 = pdf(d1);

  // Price
  const rawPrice = isCall
    ? S * expNegativeQT * Nd1 - K * expNegativeRT * Nd2
    : K * expNegativeRT * NNegD2 - S * expNegativeQT * NNegD1;
  const price = Math.max(0, rawPrice);

  // Delta: dPrice / dS
  const delta = isCall ? expNegativeQT * Nd1 : -expNegativeQT * NNegD1;

  // Gamma: d^2Price / dS^2 (same for Call and Put)
  const gamma = (expNegativeQT * pdfD1) / (S * sigmaSqrtT);

  // Vega: dPrice / dSigma (scaled per 1% vol shift: multiply by 0.01)
  const rawVega = S * expNegativeQT * sqrtT * pdfD1;
  const vega = rawVega * 0.01;

  // Theta: -dPrice / dT (scaled per calendar day: divide by 365)
  const commonTheta = -(S * expNegativeQT * pdfD1 * sigma) / (2 * sqrtT);
  const rawTheta = isCall
    ? commonTheta - r * K * expNegativeRT * Nd2 + q * S * expNegativeQT * Nd1
    : commonTheta + r * K * expNegativeRT * NNegD2 - q * S * expNegativeQT * NNegD1;
  const theta = rawTheta / 365;

  // Rho: dPrice / dr (scaled per 1% interest rate shift: multiply by 0.01)
  const rawRho = isCall
    ? K * T * expNegativeRT * Nd2
    : -K * T * expNegativeRT * NNegD2;
  const rho = rawRho * 0.01;

  return {
    price,
    delta,
    gamma,
    theta,
    vega,
    rho,
  };
};

/**
 * Calculates net Greeks for an individual portfolio leg (Option or Stock).
 * Scales Greeks by contracts * 100 * (side === 'LONG' ? 1 : -1) for options,
 * and by contracts * (side === 'LONG' ? 1 : -1) for stock equity.
 */
export const calculateLegGreeks = (
  leg: OptionLeg,
  spot: number,
  simDte: number,
  ivShift: number,
  r: number,
  q: number
): GreeksResult => {
  const isLong = leg.side === 'LONG';
  const sign = isLong ? 1 : -1;

  if (leg.legType === 'STOCK') {
    // Stock shares: 1 share has delta = 1, gamma = 0, theta = 0, vega = 0, rho = 0
    const shares = leg.contracts;
    return {
      price: spot,
      delta: shares * sign,
      gamma: 0,
      theta: 0,
      vega: 0,
      rho: 0,
    };
  }

  // OPTION leg
  const shockedIv = Math.max(0.01, leg.impliedVol + ivShift);
  const effectiveDte = Math.max(0, simDte);
  const timeYears = effectiveDte / 365;

  const unitGreeks = calculateBlackScholes(
    spot,
    leg.strike,
    timeYears,
    shockedIv,
    r,
    q,
    leg.type
  );

  const positionMultiplier = leg.contracts * 100 * sign;

  return {
    price: unitGreeks.price,
    delta: unitGreeks.delta * positionMultiplier,
    gamma: unitGreeks.gamma * positionMultiplier,
    theta: unitGreeks.theta * positionMultiplier,
    vega: unitGreeks.vega * positionMultiplier,
    rho: unitGreeks.rho * positionMultiplier,
  };
};
</file>

<file path="src/services/math/marginEngine.ts">
import type { OptionLeg } from '../../types/derivatives.ts';

/**
 * Calculates the required collateral / margin requirement for a derivatives portfolio.
 * Accurately models FINRA / CBOE margin rules:
 * - Cash-Secured Put: strike * 100 * contracts
 * - Covered Call: spotPrice * contracts (equity purchase/carry cost)
 * - Vertical Spreads (Credit/Debit): strike width * 100 * contracts
 * - Iron Condor: max(putWingWidth, callWingWidth) * 100 * contracts
 * - Straddle / Strangle / Naked Option: Standard Reg-T margin requirement
 */
export const calculateMarginRequirement = (
  legs: OptionLeg[],
  spotPrice: number
): number => {
  const activeLegs = legs.filter((l) => l.isOpen);
  if (activeLegs.length === 0) return 0;

  const stockLegs = activeLegs.filter((l) => l.legType === 'STOCK');
  const optionLegs = activeLegs.filter((l) => l.legType === 'OPTION');

  const puts = optionLegs.filter((l) => l.type === 'PUT');
  const calls = optionLegs.filter((l) => l.type === 'CALL');

  const longPuts = puts.filter((l) => l.side === 'LONG');
  const shortPuts = puts.filter((l) => l.side === 'SHORT');
  const longCalls = calls.filter((l) => l.side === 'LONG');
  const shortCalls = calls.filter((l) => l.side === 'SHORT');

  // Case 1: Iron Condor
  // 1 Long Put, 1 Short Put, 1 Short Call, 1 Long Call, no stock
  if (
    stockLegs.length === 0 &&
    longPuts.length === 1 &&
    shortPuts.length === 1 &&
    shortCalls.length === 1 &&
    longCalls.length === 1
  ) {
    const putWingWidth = Math.abs(shortPuts[0].strike - longPuts[0].strike);
    const callWingWidth = Math.abs(longCalls[0].strike - shortCalls[0].strike);
    const contracts = Math.min(
      shortPuts[0].contracts,
      longPuts[0].contracts,
      shortCalls[0].contracts,
      longCalls[0].contracts
    );
    return Math.max(putWingWidth, callWingWidth) * 100 * contracts;
  }

  // Case 2: Covered Call
  // 1 Long Stock (>= 100 shares) + Short Calls covered by stock
  if (
    stockLegs.length === 1 &&
    stockLegs[0].side === 'LONG' &&
    shortCalls.length > 0 &&
    shortPuts.length === 0 &&
    longCalls.length === 0 &&
    longPuts.length === 0
  ) {
    // Equity purchase cost (spotPrice * shares)
    return spotPrice * stockLegs[0].contracts;
  }

  // Case 3: Collar
  // 1 Long Stock + 1 Long Put + 1 Short Call
  if (
    stockLegs.length === 1 &&
    stockLegs[0].side === 'LONG' &&
    longPuts.length === 1 &&
    shortCalls.length === 1
  ) {
    return spotPrice * stockLegs[0].contracts;
  }

  // Case 4: Cash-Secured Put
  // 1 Short Put, no stock, no other options
  if (
    stockLegs.length === 0 &&
    shortPuts.length === 1 &&
    longPuts.length === 0 &&
    shortCalls.length === 0 &&
    longCalls.length === 0
  ) {
    return shortPuts[0].strike * 100 * shortPuts[0].contracts;
  }

  // Case 5: Vertical Spreads (Call Spread or Put Spread)
  // 2 options: 1 Long, 1 Short of same option type
  if (stockLegs.length === 0 && optionLegs.length === 2) {
    if (calls.length === 2 && longCalls.length === 1 && shortCalls.length === 1) {
      const strikeWidth = Math.abs(longCalls[0].strike - shortCalls[0].strike);
      const contracts = Math.min(longCalls[0].contracts, shortCalls[0].contracts);
      return strikeWidth * 100 * contracts;
    }
    if (puts.length === 2 && longPuts.length === 1 && shortPuts.length === 1) {
      const strikeWidth = Math.abs(longPuts[0].strike - shortPuts[0].strike);
      const contracts = Math.min(longPuts[0].contracts, shortPuts[0].contracts);
      return strikeWidth * 100 * contracts;
    }
  }

  // Case 6: Fallback Reg-T margin aggregation for multi-leg / arbitrary positions
  let totalMargin = 0;

  // Stock positions
  for (const s of stockLegs) {
    if (s.side === 'LONG') {
      totalMargin += spotPrice * s.contracts;
    } else {
      // Short stock Reg-T: 150% of short market value (or 100% + 50%)
      totalMargin += spotPrice * s.contracts * 1.5;
    }
  }

  // For long options: capital outlay is 100% of premium
  // For naked short options: FINRA standard 20% rule
  for (const opt of optionLegs) {
    const contracts = opt.contracts;
    const premium = opt.premium;

    if (opt.side === 'LONG') {
      totalMargin += premium * 100 * contracts;
    } else {
      // Short option naked margin requirement
      if (opt.type === 'CALL') {
        const otmAmount = Math.max(0, opt.strike - spotPrice);
        const formula1 = 0.2 * spotPrice - otmAmount + premium;
        const formula2 = 0.1 * spotPrice + premium;
        totalMargin += Math.max(formula1, formula2) * 100 * contracts;
      } else {
        // Short PUT
        const otmAmount = Math.max(0, spotPrice - opt.strike);
        const formula1 = 0.2 * spotPrice - otmAmount + premium;
        const formula2 = 0.1 * opt.strike + premium;
        totalMargin += Math.max(formula1, formula2) * 100 * contracts;
      }
    }
  }

  return Math.round(totalMargin);
};
